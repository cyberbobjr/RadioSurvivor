# Configuration du pont RadioSurvivor : copier ce fichier en .env (même dossier) et le remplir.
# Le .env est ignoré par Git ; ne jamais le versionner ni l'afficher.
# Une variable d'environnement du même nom l'emporte sur ce fichier.
OPENAI_KEY=<votre clé API>
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=<nom du modèle>
# Facultatif : plafonds de chaque appel (défauts 16000 jetons et 128000 caractères ; voir le wiki, page 08).
# LLM_MAX_TOKENS=16000
# LLM_MAX_PROMPT_CHARS=128000
